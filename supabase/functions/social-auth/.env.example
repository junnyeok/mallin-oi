# Server-only examples. Do not put actual values in Git, assets/, www/, chat or logs.
# SUPABASE_URL and SUPABASE_ANON_KEY are supplied by the Edge Functions runtime.
SOCIAL_AUTH_ENABLED=false
MALLINOI_SERVICE_ROLE_KEY=
SOCIAL_ALLOWED_ORIGINS=https://mallin-oi.com,capacitor://localhost,http://localhost,https://localhost
SOCIAL_RETURN_URIS=https://mallin-oi.com/account/social-callback.html,mallinoi://auth/callback
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_CLIENT_SECRET=
# 32 random bytes, base64-encoded; retain securely for decrypting Apple revocation credentials.
SOCIAL_CREDENTIAL_KEY=

# Public identifiers used to validate signed provider notifications.
SOCIAL_APPLE_APP_ID=com.mallinoi.calendar
SOCIAL_KAKAO_APP_ID=1612691

# Optional staged acceptance: only these existing members may link/sign in. Empty permits public use.
SOCIAL_AUTH_TEST_EMAILS=
