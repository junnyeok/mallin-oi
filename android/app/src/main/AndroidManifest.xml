<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="calendar" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".StudyFourDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_study_four_days">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_study_four_days" />
        </receiver>

        <receiver
            android:name=".StudyTwoWeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_study_two_weeks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_study_two_weeks" />
        </receiver>

        <receiver
            android:name=".StudyMonthWidgetProvider"
            android:exported="true"
            android:label="@string/widget_study_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_study_month" />
        </receiver>

        <receiver
            android:name=".WorkFourDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_work_four_days">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_work_four_days" />
        </receiver>

        <receiver
            android:name=".WorkTwoWeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_work_two_weeks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_work_two_weeks" />
        </receiver>

        <receiver
            android:name=".WorkMonthWidgetProvider"
            android:exported="true"
            android:label="@string/widget_work_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_work_month" />
        </receiver>

        <receiver
            android:name=".EventFourDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_event_four_days">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_event_four_days" />
        </receiver>

        <receiver
            android:name=".EventTwoWeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_event_two_weeks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_event_two_weeks" />
        </receiver>

        <receiver
            android:name=".EventMonthWidgetProvider"
            android:exported="true"
            android:label="@string/widget_event_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_event_month" />
        </receiver>

        <receiver
            android:name=".CalendarWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mallinoi.calendar.action.WIDGET_MIDNIGHT_REFRESH" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
